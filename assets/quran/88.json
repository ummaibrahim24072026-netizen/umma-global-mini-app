{"number":88,"verses":[{"number":1,"arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَٰشِيَةِ","translation":"Дошел ли до тебя рассказ о Покрывающем (Дне воскресения)?"},{"number":2,"arabic":"وُجُوهٌۭ يَوْمَئِذٍ خَٰشِعَةٌ","translation":"Одни лица в тот день будут унижены,"},{"number":3,"arabic":"عَامِلَةٌۭ نَّاصِبَةٌۭ","translation":"изнурены и утомлены."},{"number":4,"arabic":"تَصْلَىٰ نَارًا حَامِيَةًۭ","translation":"Они войдут в Огонь жаркий."},{"number":5,"arabic":"تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍۢ","translation":"Их будут поить из источника кипящего"},{"number":6,"arabic":"لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍۢ","translation":"и кормить только ядовитыми колючками,"},{"number":7,"arabic":"لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍۢ","translation":"от которых не поправляются и которые не утоляют голода."},{"number":8,"arabic":"وُجُوهٌۭ يَوْمَئِذٍۢ نَّاعِمَةٌۭ","translation":"Другие же лица в тот день будут радостны."},{"number":9,"arabic":"لِّسَعْيِهَا رَاضِيَةٌۭ","translation":"Они будут довольны своими стараниями"},{"number":10,"arabic":"فِى جَنَّةٍ عَالِيَةٍۢ","translation":"в Вышних садах."},{"number":11,"arabic":"لَّا تَسْمَعُ فِيهَا لَٰغِيَةًۭ","translation":"Они не услышат там словоблудия."},{"number":12,"arabic":"فِيهَا عَيْنٌۭ جَارِيَةٌۭ","translation":"Там есть источник текущий."},{"number":13,"arabic":"فِيهَا سُرُرٌۭ مَّرْفُوعَةٌۭ","translation":"Там воздвигнуты ложа,"},{"number":14,"arabic":"وَأَكْوَابٌۭ مَّوْضُوعَةٌۭ","translation":"расставлены чаши,"},{"number":15,"arabic":"وَنَمَارِقُ مَصْفُوفَةٌۭ","translation":"разложены подушки,"},{"number":16,"arabic":"وَزَرَابِىُّ مَبْثُوثَةٌ","translation":"и разостланы ковры."},{"number":17,"arabic":"أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ","translation":"Неужели они не видят, как созданы верблюды,"},{"number":18,"arabic":"وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ","translation":"как вознесено небо,"},{"number":19,"arabic":"وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ","translation":"как водружены горы,"},{"number":20,"arabic":"وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ","translation":"как распростерта земля?"},{"number":21,"arabic":"فَذَكِّرْ إِنَّمَآ أَنتَ مُذَكِّرٌۭ","translation":"Наставляй же, ведь ты - наставник,"},{"number":22,"arabic":"لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ","translation":"и ты не властен над ними."},{"number":23,"arabic":"إِلَّا مَن تَوَلَّىٰ وَكَفَرَ","translation":"А тех, кто отвернется и не уверует,"},{"number":24,"arabic":"فَيُعَذِّبُهُ ٱللَّهُ ٱلْعَذَابَ ٱلْأَكْبَرَ","translation":"Аллах подвергнет величайшим мучениям."},{"number":25,"arabic":"إِنَّ إِلَيْنَآ إِيَابَهُمْ","translation":"К Нам они вернутся,"},{"number":26,"arabic":"ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم","translation":"и затем Мы потребуем у них отчета."}]}