{"number":107,"verses":[{"number":1,"arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ","translation":"Видел ли ты того, кто считает ложью воздаяние?"},{"number":2,"arabic":"فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ","translation":"Это - тот, кто гонит сироту"},{"number":3,"arabic":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ","translation":"и не побуждает накормить бедняка."},{"number":4,"arabic":"فَوَيْلٌۭ لِّلْمُصَلِّينَ","translation":"Горе молящимся,"},{"number":5,"arabic":"ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ","translation":"которые небрежны к своим намазам,"},{"number":6,"arabic":"ٱلَّذِينَ هُمْ يُرَآءُونَ","translation":"которые лицемерят"},{"number":7,"arabic":"وَيَمْنَعُونَ ٱلْمَاعُونَ","translation":"и отказывают даже в мелочи!"}]}