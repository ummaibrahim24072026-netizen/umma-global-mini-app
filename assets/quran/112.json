{"number":112,"verses":[{"number":1,"arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ هُوَ ٱللَّهُ أَحَدٌ","translation":"Скажи: «Он - Аллах Единый,"},{"number":2,"arabic":"ٱللَّهُ ٱلصَّمَدُ","translation":"Аллах Самодостаточный."},{"number":3,"arabic":"لَمْ يَلِدْ وَلَمْ يُولَدْ","translation":"Он не родил и не был рожден,"},{"number":4,"arabic":"وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ","translation":"и нет никого равного Ему»."}]}